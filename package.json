{
  "name": "delta-harmonica-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local, manual-play harmonica visual assistant for Windows 11",
  "author": "Delta Harmonica Assistant contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "check:readability": "node scripts/check-readability.mjs",
    "start": "electron .",
    "package": "npm run check && electron-builder --win dir --x64 --publish never && node scripts/portable.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke-prepare.mjs && node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.58.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "local.delta.harmonica",
    "productName": "Delta Harmonica Assistant",
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "node_modules/koffi/**/*.node"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**/*",
      "!node_modules/koffi/{src,vendor,doc}/**/*",
      "!dist-electron/**/*.map"
    ],
    "directories": {
      "output": "release/v0.1.0"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "artifactName": "Delta-Harmonica-Assistant-${version}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Windrise1225/Delta-Harmonica-Assistant.git"
  }
}
