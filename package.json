{
  "name": "delta-harmonica-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Local, manual-play harmonica visual assistant for Windows 11",
  "author": "Delta Harmonica Assistant contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "electron .",
    "package": "npm run check && electron-builder --win dir --publish never && node scripts/portable.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke-prepare.mjs && node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "local.delta.harmonica",
    "productName": "Delta Harmonica Assistant",
    "asar": true,
    "asarUnpack": ["node_modules/koffi/**/*"],
    "files": ["dist/**/*", "dist-electron/**/*", "assets/icon.png", "package.json", "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**/*", "!node_modules/koffi/{src,vendor,doc}/**/*"],
    "directories": { "output": "release/lavender" },
    "electronDist": "node_modules/electron/dist",
    "win": { "target": "dir", "signExecutable": false, "icon": "assets/icon.ico" },
    "electronLanguages": ["zh-CN", "en-US"],
    "artifactName": "Delta-Harmonica-Assistant-${version}-${arch}.${ext}"
  }
}
